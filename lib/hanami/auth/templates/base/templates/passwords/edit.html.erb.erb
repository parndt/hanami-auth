<h1><%%= t(".heading") %></h1>

<%% if flash[:alert] %><p role="alert"><%%= flash[:alert] %></p><%% end %>

<%%= form_for routes.path(:<%= route(:password) %>, id: token), method: :patch do |f| %>
  <p>
    <label for="password"><%%= t(".password") %></label>
    <%%= f.password_field "password", id: "password", required: true, autofocus: true, autocomplete: "new-password", minlength: 12 %>
  </p>

  <p>
    <label for="password_confirmation"><%%= t(".password_confirmation") %></label>
    <%%= f.password_field "password_confirmation", id: "password_confirmation", required: true, autocomplete: "new-password" %>
  </p>

  <p><%%= f.submit t(".submit") %></p>
<%% end %>
