# frozen_string_literal: true

module <%= namespace %>
  module Actions
    module Session
      class Create < <%= namespace %>::Action
        allow_unauthenticated_access
        rate_limit to: 10, within: 3 * 60, redirect: :<%= route(:new_session) %>

        include Deps["operations.sign_in", view: "views.session.new"]

        params do
          required(:email_address).filled(:string)
          required(:password).filled(:string)
        end

        def handle(request, response)
          return reject(response) unless request.params.valid?

          case sign_in.call(**request.params.to_h)
          in Success(<%= model %>)
            start_new_session_for(request, <%= model %>)
            response.flash[:notice] = t(".signed_in")
            response.redirect_to after_authentication_url(request), status: 303
          in Failure(:invalid_credentials)
            reject(response)
          end
        end

        private

        def reject(response)
          response.flash.now[:alert] = t(".invalid_credentials")
          response.status = 422
          response.render(view)
        end
      end
    end
  end
end
