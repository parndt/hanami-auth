# frozen_string_literal: true

module <%= namespace %>
  module Actions
    module Passwords
      class Create < <%= namespace %>::Action
        allow_unauthenticated_access

        include Deps["operations.request_password_reset", view: "views.passwords.new"]

        params do
          required(:email_address).filled(:string)
        end

        def handle(request, response)
          unless request.params.valid?
            response.flash.now[:alert] = t(".email_address_missing")
            response.status = 422
            return response.render(view)
          end

          request_password_reset.call(email_address: request.params[:email_address])

          # The same response either way, so this form can't be used to discover accounts.
          response.flash[:notice] = t(".sent")
          response.redirect_to routes.path(:<%= route(:new_session) %>), status: 303
        end
      end
    end
  end
end
