# frozen_string_literal: true

module <%= namespace %>
  module Actions
    module Passwords
      class Edit < <%= namespace %>::Action
        allow_unauthenticated_access

        include Deps["authentication.password_reset_tokens"]

        params do
          required(:id).filled(:string)
        end

        def handle(request, response)
          token = request.params[:id]

          if request.params.valid? && password_reset_tokens.resolve(token)
            response[:token] = token
            return
          end

          response.flash[:alert] = t(".invalid_token")
          response.redirect_to routes.path(:<%= route(:new_password) %>)
        end
      end
    end
  end
end
