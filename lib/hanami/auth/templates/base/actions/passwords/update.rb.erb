# frozen_string_literal: true

module <%= namespace %>
  module Actions
    module Passwords
      class Update < <%= namespace %>::Action
        allow_unauthenticated_access

        include Deps["operations.reset_password", view: "views.passwords.edit"]

        params do
          required(:id).filled(:string)
          required(:password).filled(:string)
          required(:password_confirmation).filled(:string)
        end

        def handle(request, response)
          token = request.params[:id]
          return reject(request, response, t(".passwords_missing")) unless request.params.valid?

          result = reset_password.call(
            token:,
            password: request.params[:password],
            password_confirmation: request.params[:password_confirmation]
          )

          case result
          in Success(_)
            response.flash[:notice] = t(".reset")
            response.redirect_to routes.path(:<%= route(:new_session) %>), status: 303
          in Failure(:invalid_token)
            response.flash[:alert] = t(".invalid_token")
            response.redirect_to routes.path(:<%= route(:new_password) %>), status: 303
          in Failure(:password_too_short)
            reject(request, response, t(".password_too_short", count: Operations::ResetPassword::MINIMUM_LENGTH))
          in Failure(:password_mismatch)
            reject(request, response, t(".password_mismatch"))
          end
        end

        private

        def reject(request, response, message)
          response.flash.now[:alert] = message
          response.status = 422
          response.render(view, token: request.params[:id])
        end
      end
    end
  end
end
