# frozen_string_literal: true

module <%= namespace %>
  module Mailers
    class PasswordReset < <%= namespace %>::Mailer
      include Deps["i18n"]

      from "noreply@example.com"
      to { |<%= model %>:| <%= model %>.email_address }
      subject { i18n.t("mailers.password_reset.subject") }

      expose :<%= model %>, :reset_url
    end
  end
end
