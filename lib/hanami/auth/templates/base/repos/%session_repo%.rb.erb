# frozen_string_literal: true

module <%= namespace %>
  module Repos
    class <%= session_repo_class %> < <%= namespace %>::DB::Repo
      # Matches the session cookie's `expire_after` in config/app.rb. The cookie's expiry is up to the
      # browser, so the database enforces it too: a token copied out of an old cookie stops working.
      LIFETIME = 60 * 60 * 24 * 30 # 30 days

      def create(<%= foreign_key %>:, token_digest:, ip_address: nil, user_agent: nil, now: Time.now)
        <%= sessions_table %>.changeset(
          :create,
          <%= foreign_key %>:, token_digest:, ip_address:, user_agent:, created_at: now, updated_at: now
        ).commit
      end

      # Returns the session, combined with its <%= model %>, unless it has expired.
      def find_by_token_digest(token_digest, now: Time.now)
        <%= sessions_table %>.where(token_digest:).where { created_at > now - LIFETIME }.combine(:<%= model %>).one
      end

      def delete(id)
        <%= sessions_table %>.by_pk(id).delete
      end

      def delete_all_for_<%= model %>(<%= foreign_key %>)
        <%= sessions_table %>.where(<%= foreign_key %>:).delete
      end

      # Expired sessions no longer sign anyone in, but stay in the table until this removes them.
      def delete_expired(now: Time.now)
        <%= sessions_table %>.where { created_at <= now - LIFETIME }.delete
      end
    end
  end
end
