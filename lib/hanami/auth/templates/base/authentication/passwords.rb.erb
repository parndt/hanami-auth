# frozen_string_literal: true

require "argon2"

module <%= namespace %>
  module Authentication
    # Hashes and verifies passwords with Argon2id.
    class Passwords
      # Verified against when no user matches, so a failed sign in takes the same time whether or not
      # the email address belongs to an account. Hashed on first use rather than at boot, since
      # hashing is deliberately slow.
      def self.dummy_hash
        @dummy_hash ||= Argon2::Password.create("hanami-auth timing equalizer")
      end

      def digest(password)
        Argon2::Password.create(password)
      end

      def verify(password, password_hash)
        return false if password.to_s.empty?

        Argon2::Password.verify_password(password, password_hash || self.class.dummy_hash)
      rescue Argon2::ArgonHashFail
        false
      end
    end
  end
end
